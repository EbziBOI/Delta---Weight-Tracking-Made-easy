<?xml version="1.0" encoding="utf-8"?>
<!-- Navy gradient behind the mark. The gradient spans the visible 72dp so the
     launcher mask shows the full run from top to bottom. -->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:aapt="http://schemas.android.com/aapt"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">
    <path android:pathData="M0,0h108v108h-108z">
        <aapt:attr name="android:fillColor">
            <gradient
                android:endColor="#FF070B1C"
                android:endX="54"
                android:endY="90"
                android:startColor="#FF1A2A63"
                android:startX="54"
                android:startY="18"
                android:type="linear" />
        </aapt:attr>
    </path>
</vector>
